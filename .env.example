# 复制本文件为 .env（同目录），把你有的 key 填进对应行，然后设置最上面的
# LLM_PROVIDER 选一个模型，让我重启即可。
# .env 已被 .gitignore —— key 不会进 git，也不会离开你这台机器。

# ============================================================
# 第 1 步：选一个模型（改这一行就能切换，不用动下面的 key）
#   可选：ollama  /  anthropic  /  openai  /  deepseek  /  kimi  /  bailian
# ============================================================
LLM_PROVIDER=ollama


# ============================================================
# 第 2 步：把你有的 key 填进来（有几家填几家，互不影响）
# ============================================================

# ---- DeepSeek（最便宜，够用）----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat        # 可选，默认 deepseek-chat

# ---- Kimi / Moonshot ----
MOONSHOT_API_KEY=
# KIMI_MODEL=moonshot-v1-32k          # 可选，默认 moonshot-v1-32k

# ---- 阿里云百炼 / DashScope（国内直连、通义千问）----
DASHSCOPE_API_KEY=
# BAILIAN_MODEL=qwen-plus             # 可选：qwen-plus / qwen-max / qwen-turbo / qwen-long 等

# ---- GPT（OpenAI 官方）----
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o                 # 可选，换成你账户能用的 GPT 型号
# OPENAI_BASE_URL=https://api.openai.com/v1   # 一般不用改

# ---- Claude（会计推理最准）----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5     # 可选，最强用 claude-opus-4-8

# ---- 本地 Ollama（默认，免费，不用 key）----
# 选 LLM_PROVIDER=ollama 时以上都不填也能跑
